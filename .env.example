# ==============================================================================
# API Gateway Environment Configuration Template
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_APPLICATION_NAME=api-gateway

# Eureka Service Discovery
EUREKA_HOSTNAME=localhost
EUREKA_SERVICE_URL=http://localhost:8761/eureka/

# Downstream Service Discovery IDs
AUTH_SERVICE_URI=lb://auth-service
DOCUMENT_SERVICE_URI=lb://document-service
AI_SERVICE_URI=lb://ai-service

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Actuator & Observability
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
